{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentserver.dev/v2/schema/run-capability-keyring.schema.json",
  "title": "agentserver v2 production run capability verification keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "keys"],
  "properties": {
    "version": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKey"],
        "properties": {
          "keyId": {"type": "string", "minLength": 1, "maxLength": 256},
          "algorithm": {"const": "ed25519-v1"},
          "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
        }
      }
    }
  }
}
