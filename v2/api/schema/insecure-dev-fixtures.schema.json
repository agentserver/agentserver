{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentserver.dev/v2/schema/insecure-dev-fixtures.schema.json",
  "title": "Agentserver v2 insecure development fixture launch config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authority", "hydra", "llmproxy"],
  "properties": {
    "version": {"const": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "sessionId", "actorId"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/uuid"},
        "sessionId": {"$ref": "#/$defs/uuid"},
        "actorId": {"$ref": "#/$defs/uuid"}
      }
    },
    "hydra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introspectionEndpoint", "browserBearerTokenFile", "audience", "scope", "responseTtl"],
      "properties": {
        "introspectionEndpoint": {"type": "string", "format": "uri", "pattern": "^http://", "maxLength": 4096},
        "browserBearerTokenFile": {"$ref": "#/$defs/absolutePath"},
        "audience": {"const": "agentserver-api"},
        "scope": {"const": "runs:write"},
        "responseTtl": {"type": "string", "minLength": 2, "maxLength": 64}
      }
    },
    "llmproxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "certificateFile",
        "privateKeyFile",
        "runCapabilityKeyFile",
        "model",
        "provider",
        "toolNamespace",
        "scriptedTool",
        "finalMessage"
      ],
      "properties": {
        "endpoint": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
        "certificateFile": {"$ref": "#/$defs/absolutePath"},
        "privateKeyFile": {"$ref": "#/$defs/absolutePath"},
        "runCapabilityKeyFile": {"$ref": "#/$defs/absolutePath"},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "provider": {"type": "string", "minLength": 1, "maxLength": 256},
        "toolNamespace": {"const": "executor"},
        "scriptedTool": {"const": "list_environments"},
        "finalMessage": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    }
  }
}
