{
  "version": 1,
  "namespace": "agentserver",
  "clusterDomain": "cluster.local",
  "platform": "linux-arm64",
  "images": {
    "service": "registry.example.com/agentserver/service@sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "harness": "registry.example.com/agentserver/harness@sha256:2222222222222222222222222222222222222222222222222222222222222222"
  },
  "replicas": {
    "core": 2,
    "browserGateway": 2,
    "harnessPool": 2,
    "llmproxy": 2
  },
  "services": {
    "core": {"clusterIp": "10.96.10.10", "port": 8443},
    "browserGateway": {
      "clusterIp": "10.96.10.11",
      "port": 8443,
      "publicHostname": "agent.example.com"
    },
    "executorGateway": {
      "clusterIp": "10.96.10.12",
      "port": 8443,
      "publicHostname": "executor.example.com"
    },
    "llmproxy": {"clusterIp": "10.96.10.13", "port": 8443}
  },
  "bootstrap": {
    "workspaceId": "40000000-0000-4000-8000-000000000004",
    "sessionId": "50000000-0000-4000-8000-000000000005",
    "ownerUserId": "10000000-0000-4000-8000-000000000001",
    "externalOidcSubject": "replace-with-exact-idp-subject",
    "executorId": "20000000-0000-4000-8000-000000000002"
  },
  "spiffeTrustDomain": "agentserver.example.com",
  "oauth": {
    "hydra": {
      "issuer": "https://auth.example.com",
      "adminUrl": "https://hydra-admin.example.com",
      "publicOrigin": "https://auth.example.com",
      "introspectionUrl": "https://hydra-admin.example.com/admin/oauth2/introspect",
      "browserClientId": "agentserver-browser"
    },
    "externalOidc": {
      "issuer": "https://idp.example.com/oidc",
      "clientId": "agentserver-production",
      "redirectUrl": "https://agent.example.com/auth/oidc/callback"
    }
  },
  "runtime": {
    "capabilityIssuer": "spiffe://agentserver.example.com/ns/agentserver/sa/agentserver-core",
    "capabilitySigningKeyId": "run-capability-2026-08",
    "manifestSigningKeyId": "run-manifest-2026-08",
    "model": "gpt-5",
    "provider": "openai",
    "upstreamResponsesUrl": "https://api.openai.com/v1/responses",
    "upstreamAuthHeader": "Authorization",
    "runPolicyVersion": "run-policy-v1",
    "allowedTools": ["list_environments", "read_file", "shell"],
    "executionPolicyVersion": "execution-policy-v1",
    "shellPolicyDecision": "ask",
    "readFilePolicyDecision": "allow",
    "maxRunDuration": "30m",
    "maxApprovalTtl": "5m",
    "capabilityExpiryGrace": "30s",
    "enrollmentTokenTtl": "5m",
    "maxConcurrentAttempts": 4,
    "runtimeManifestSha256": "bd226a5e888a73f31372f02e0b7a48763f50cc4a2acfac28e9dc48df4e7679fa",
    "checkpointAllowlistVersion": 1,
    "finalExecSha256": "4444444444444444444444444444444444444444444444444444444444444444",
    "finalExecSizeBytes": 1048576
  },
  "objectStore": {
    "prefix": "agentserver/v2/production",
    "s3Bucket": "agentserver-production",
    "s3Region": "ap-southeast-1",
    "s3UsePathStyle": false,
    "kmsRegion": "ap-southeast-1",
    "kmsKeyId": "arn:aws:kms:ap-southeast-1:123456789012:key/11111111-1111-4111-8111-111111111111",
    "coreRoleArn": "arn:aws:iam::123456789012:role/agentserver-core",
    "harnessPoolRoleArn": "arn:aws:iam::123456789012:role/agentserver-harness-pool"
  },
  "secrets": {
    "core": "agentserver-core-secrets",
    "browserGateway": "agentserver-browser-secrets",
    "executorGateway": "agentserver-executor-secrets",
    "harnessPool": "agentserver-pool-secrets",
    "harnessWorker": "agentserver-worker-secrets",
    "llmproxy": "agentserver-llmproxy-secrets"
  },
  "network": {
    "dnsClusterIp": "10.96.0.10",
    "dnsNamespace": "kube-system",
    "dnsPodSelector": {
      "k8s-app": "kube-dns"
    },
    "databaseEgress": [{"cidr": "10.20.0.10/32", "ports": [5432]}],
    "coreExternalEgress": [{"cidr": "192.0.2.0/24", "ports": [443]}],
    "browserExternalEgress": [{"cidr": "198.51.100.0/24", "ports": [443]}],
    "harnessExternalEgress": [{"cidr": "192.0.2.0/24", "ports": [443]}],
    "llmproxyExternalEgress": [{"cidr": "203.0.113.0/24", "ports": [443]}],
    "browserIngressCidrs": ["0.0.0.0/0"],
    "executorIngressCidrs": ["203.0.113.0/24"]
  },
  "resources": {
    "core": {
      "requests": {"cpu": "500m", "memory": "512Mi"},
      "limits": {"cpu": "2", "memory": "2Gi"}
    },
    "browserGateway": {
      "requests": {"cpu": "250m", "memory": "256Mi"},
      "limits": {"cpu": "1", "memory": "1Gi"}
    },
    "executorGateway": {
      "requests": {"cpu": "500m", "memory": "512Mi"},
      "limits": {"cpu": "2", "memory": "2Gi"}
    },
    "harnessPool": {
      "requests": {"cpu": "1", "memory": "2Gi"},
      "limits": {"cpu": "4", "memory": "16Gi"}
    },
    "llmproxy": {
      "requests": {"cpu": "500m", "memory": "512Mi"},
      "limits": {"cpu": "2", "memory": "2Gi"}
    },
    "runtimeTmpfs": "8Gi",
    "checkpointTmpfs": "2Gi",
    "scratchTmpfs": "512Mi"
  }
}
