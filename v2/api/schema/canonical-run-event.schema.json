{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentserver.dev/v2/schema/canonical-run-event.schema.json",
  "title": "agentserver v2 canonical run event",
  "description": "Persistence-neutral envelope returned by the authorized core run-event cursor. Known browser projection kinds use closed schema-v1 payloads; unknown future kinds may remain opaque ledger facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "seq",
    "workspaceId",
    "sessionId",
    "runId",
    "runAttemptId",
    "runAttemptGeneration",
    "producerInstanceId",
    "producerSeq",
    "source",
    "kind",
    "createdAt"
  ],
  "properties": {
    "eventId": {"$ref": "#/$defs/canonicalUUID"},
    "schemaVersion": {"$ref": "#/$defs/positiveSafeInteger"},
    "seq": {"$ref": "#/$defs/positiveSafeInteger"},
    "workspaceId": {"$ref": "#/$defs/canonicalUUID"},
    "sessionId": {"$ref": "#/$defs/canonicalUUID"},
    "runId": {"$ref": "#/$defs/canonicalUUID"},
    "runAttemptId": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/canonicalUUID"}
      ]
    },
    "runAttemptGeneration": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/positiveSafeInteger"}
      ]
    },
    "producerInstanceId": {"$ref": "#/$defs/canonicalUUID"},
    "producerSeq": {"$ref": "#/$defs/positiveSafeInteger"},
    "source": {"enum": ["brain", "executor", "system", "approval"]},
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "object": {"$ref": "#/$defs/objectPointer"}
  },
  "oneOf": [
    {
      "required": ["payload"],
      "not": {"required": ["object"]}
    },
    {
      "required": ["object"],
      "not": {"required": ["payload"]}
    }
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "runAttemptId": {"type": "null"},
            "runAttemptGeneration": {"type": "null"}
          }
        },
        {
          "properties": {
            "runAttemptId": {"$ref": "#/$defs/canonicalUUID"},
            "runAttemptGeneration": {"$ref": "#/$defs/positiveSafeInteger"}
          }
        }
      ]
    },
    {
      "if": {"properties": {"kind": {"enum": ["assistant.message.started", "assistant.reasoning.started"]}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/messageStartedPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["assistant.message.delta", "assistant.reasoning.delta"]}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/messageDeltaPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["assistant.message.completed", "assistant.reasoning.completed"]}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/messageCompletedPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "tool.call.started"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/toolCallStartedPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "tool.call.arguments"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/toolCallArgumentsPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "tool.call.completed"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/toolCallCompletedPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "tool.call.result"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/toolCallResultPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "run.completed"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/runCompletedPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["run.failed", "run.interrupted", "run.cancelled"]}}, "required": ["kind"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": 1},
          "payload": {"$ref": "#/$defs/runErrorPayload"}
        },
        "required": ["payload"],
        "not": {"required": ["object"]}
      }
    }
  ],
  "$defs": {
    "canonicalUUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "boundedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00\\r\\n\\t ]+$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "objectPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "sha256", "size", "mediaType"],
      "properties": {
        "objectId": {"$ref": "#/$defs/canonicalUUID"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"$ref": "#/$defs/positiveSafeInteger"},
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\x00\\r\\n]+$"
        }
      }
    },
    "messageStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "role"],
      "properties": {
        "messageId": {"$ref": "#/$defs/boundedIdentifier"},
        "role": {"const": "assistant"}
      }
    },
    "messageDeltaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "delta"],
      "properties": {
        "messageId": {"$ref": "#/$defs/boundedIdentifier"},
        "delta": {"$ref": "#/$defs/boundedText"}
      }
    },
    "messageCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId"],
      "properties": {
        "messageId": {"$ref": "#/$defs/boundedIdentifier"}
      }
    },
    "toolCallStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "toolCallName"],
      "properties": {
        "toolCallId": {"$ref": "#/$defs/boundedIdentifier"},
        "toolCallName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00\\r\\n]+$"
        },
        "parentMessageId": {"$ref": "#/$defs/boundedIdentifier"}
      }
    },
    "toolCallArgumentsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "delta"],
      "properties": {
        "toolCallId": {"$ref": "#/$defs/boundedIdentifier"},
        "delta": {"$ref": "#/$defs/boundedText"}
      }
    },
    "toolCallCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId"],
      "properties": {
        "toolCallId": {"$ref": "#/$defs/boundedIdentifier"}
      }
    },
    "commandPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "output", "status"],
      "properties": {
        "command": {"type": "string", "minLength": 1, "maxLength": 16384},
        "output": {"type": "string", "maxLength": 65536},
        "status": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "presentedFileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "diff"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00\\r\\n]+$"
        },
        "kind": {"enum": ["add", "delete", "update"]},
        "diff": {"type": "string", "maxLength": 65536}
      }
    },
    "fileChangePresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/presentedFileChange"}
        }
      }
    },
    "toolPresentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": {"const": "command"},
            "command": {"$ref": "#/$defs/commandPresentation"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fileChange"],
          "properties": {
            "kind": {"const": "file_change"},
            "fileChange": {"$ref": "#/$defs/fileChangePresentation"}
          }
        }
      ]
    },
    "toolCallResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "toolCallId", "content"],
      "properties": {
        "messageId": {"$ref": "#/$defs/boundedIdentifier"},
        "toolCallId": {"$ref": "#/$defs/boundedIdentifier"},
        "content": {"$ref": "#/$defs/boundedText"},
        "presentation": {"$ref": "#/$defs/toolPresentation"}
      }
    },
    "runCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "maxLength": 128, "pattern": "^[^\\x00\\r\\n]*$"},
        "message": {"type": "string", "maxLength": 4096},
        "result": true
      }
    },
    "runErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "code": {"type": "string", "maxLength": 128, "pattern": "^[^\\x00\\r\\n]*$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "result": true
      }
    }
  }
}
