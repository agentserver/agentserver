{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentserver.dev/v2/schema/production-deployment.schema.json",
  "title": "Agentserver v2 Phase 5 production deployment input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "region",
    "namespace",
    "clusterDomain",
    "platform",
    "images",
    "replicas",
    "services",
    "ingress",
    "bootstrap",
    "spiffeTrustDomain",
    "oauth",
    "runtime",
    "managedExecutor",
    "objectStore",
    "secrets",
    "network",
    "resources"
  ],
  "properties": {
    "version": {"enum": [5, 6]},
    "region": {"const": "sg"},
    "namespace": {"const": "agentserver"},
    "clusterDomain": {"$ref": "#/$defs/dnsName"},
    "platform": {"const": "linux-amd64"},
    "images": {"$ref": "#/$defs/images"},
    "replicas": {"$ref": "#/$defs/replicas"},
    "services": {"$ref": "#/$defs/services"},
    "ingress": {"$ref": "#/$defs/ingress"},
    "bootstrap": {"$ref": "#/$defs/bootstrap"},
    "spiffeTrustDomain": {"const": "agentserver.byted.bps.dev"},
    "oauth": {"$ref": "#/$defs/oauth"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "managedExecutor": {"$ref": "#/$defs/managedExecutor"},
    "sandboxRegions": {"$ref": "#/$defs/managedSandboxRegions"},
    "sandboxProfiles": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {"$ref": "#/$defs/managedSandboxProfile"},
      "contains": {
        "type": "object",
        "required": ["region"],
        "properties": {"region": {"const": "i18n-tt"}}
      }
    },
    "proxyProfiles": {
      "type": "array", "maxItems": 3,
      "items": {"$ref": "#/$defs/managedSandboxProxyProfile"}
    },
    "objectStore": {"$ref": "#/$defs/objectStore"},
    "secrets": {"$ref": "#/$defs/secrets"},
    "network": {"$ref": "#/$defs/network"},
    "resources": {"$ref": "#/$defs/resources"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"version": {"const": 6}},
        "required": ["version"]
      },
      "then": {
        "required": ["sandboxRegions", "sandboxProfiles", "proxyProfiles"],
        "properties": {
          "managedExecutor": {
            "properties": {
              "tae": {
                "required": ["controlPlaneUrl", "dataPlaneSuffix", "bytecloudSite", "bytecloudJwtEndpoint", "proxyProfile"]
              }
            }
          },
          "sandboxProfiles": {
            "items": {
              "properties": {
                "tae": {
                  "required": ["controlPlaneUrl", "dataPlaneSuffix", "bytecloudSite", "bytecloudJwtEndpoint", "proxyProfile"]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "dnsName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9]|[a-z0-9][a-z0-9-]{0,61}[a-z0-9])(?:\\.(?:[a-z0-9]|[a-z0-9][a-z0-9-]{0,61}[a-z0-9]))*$",
      "not": {"pattern": "\\.\\."}
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "optionalSha256": {
      "anyOf": [
        {"const": ""},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096,
      "format": "uri",
      "pattern": "^https://"
    },
    "serviceImage": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^registry-sg\\.byted\\.cs\\.ac\\.cn/ghcr/agentserver/v2-service@sha256:[0-9a-f]{64}$"
    },
    "harnessImage": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^registry-sg\\.byted\\.cs\\.ac\\.cn/ghcr/agentserver/v2-harness@sha256:[0-9a-f]{64}$"
    },
    "hydraImage": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^registry-sg\\.byted\\.cs\\.ac\\.cn/ghcr/agentserver/hydra@sha256:[0-9a-f]{64}$"
    },
    "managedSandboxImage": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^registry-sg\\.byted\\.cs\\.ac\\.cn/ghcr/agentserver/v2-managed-sandbox@sha256:[0-9a-f]{64}$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "harness", "hydra", "managedSandbox"],
      "properties": {
        "service": {"$ref": "#/$defs/serviceImage"},
        "harness": {"$ref": "#/$defs/harnessImage"},
        "hydra": {"$ref": "#/$defs/hydraImage"},
        "managedSandbox": {"$ref": "#/$defs/managedSandboxImage"}
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "platformGateway", "browserGateway", "harnessPool", "llmproxy", "hydra", "sandboxGateway", "egressAuthorizer"],
      "properties": {
        "core": {"type": "integer", "minimum": 2, "maximum": 32},
        "platformGateway": {"type": "integer", "minimum": 2, "maximum": 32},
        "browserGateway": {"type": "integer", "minimum": 2, "maximum": 32},
        "harnessPool": {"type": "integer", "minimum": 1, "maximum": 32},
        "llmproxy": {"type": "integer", "minimum": 2, "maximum": 32},
        "hydra": {"type": "integer", "minimum": 2, "maximum": 32},
        "sandboxGateway": {"type": "integer", "minimum": 2, "maximum": 32},
        "egressAuthorizer": {"type": "integer", "minimum": 2, "maximum": 32}
      }
    },
    "ipv4": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15,
      "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}$"
    },
    "internalService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterIp", "port"],
      "properties": {
        "clusterIp": {"$ref": "#/$defs/ipv4"},
        "port": {"const": 8443}
      }
    },
    "publicHTTPService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterIp", "port"],
      "properties": {
        "clusterIp": {"$ref": "#/$defs/ipv4"},
        "port": {"const": 8080}
      }
    },
    "executorService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterIp", "publicPort", "internalPort"],
      "properties": {
        "clusterIp": {"$ref": "#/$defs/ipv4"},
        "publicPort": {"const": 8080},
        "internalPort": {"const": 8443}
      }
    },
    "hydraService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterIp", "publicPort", "adminPort"],
      "properties": {
        "clusterIp": {"$ref": "#/$defs/ipv4"},
        "publicPort": {"const": 4444},
        "adminPort": {"const": 4445}
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "platformGateway", "browserGateway", "executorGateway", "llmproxy", "hydra", "sandboxGateway", "egressAuthorizer"],
      "properties": {
        "core": {"$ref": "#/$defs/internalService"},
        "platformGateway": {"$ref": "#/$defs/publicHTTPService"},
        "browserGateway": {"$ref": "#/$defs/publicHTTPService"},
        "executorGateway": {"$ref": "#/$defs/executorService"},
        "llmproxy": {"$ref": "#/$defs/internalService"},
        "hydra": {"$ref": "#/$defs/hydraService"},
        "sandboxGateway": {"$ref": "#/$defs/internalService"},
        "egressAuthorizer": {"$ref": "#/$defs/internalService"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gatewayNamespace",
        "gatewayName",
        "gatewaySection",
        "gatewayPodSelector",
        "frontendHostname",
        "browserFrontendHostname",
        "browserGatewayHostname",
        "executorGatewayHostname",
        "hydraHostname"
      ],
      "properties": {
        "gatewayNamespace": {"const": "istio-ingress"},
        "gatewayName": {"const": "istio-gateway"},
        "gatewaySection": {"const": "https-byted-bps"},
        "gatewayPodSelector": {"$ref": "#/$defs/labelSelector"},
        "frontendHostname": {"const": "agent.byted.bps.dev"},
        "browserFrontendHostname": {"const": "browser.byted.bps.dev"},
        "browserGatewayHostname": {"const": "browser-gateway.byted.bps.dev"},
        "executorGatewayHostname": {"const": "executor-gateway.byted.bps.dev"},
        "hydraHostname": {"const": "auth-sg.byted.bps.dev"}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "sessionId", "ownerUserId", "executorId"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/uuid"},
        "sessionId": {"$ref": "#/$defs/uuid"},
        "ownerUserId": {"$ref": "#/$defs/uuid"},
        "executorId": {"$ref": "#/$defs/uuid"}
      }
    },
    "hydra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "adminUrl", "publicOrigin", "introspectionUrl", "platformClientId", "browserClientId"],
      "properties": {
        "issuer": {"const": "https://auth-sg.byted.bps.dev/"},
        "adminUrl": {"const": "https://hydra.agentserver.internal:4445"},
        "publicOrigin": {"const": "https://auth-sg.byted.bps.dev"},
        "introspectionUrl": {"const": "https://hydra.agentserver.internal:4445/admin/oauth2/introspect"},
        "platformClientId": {"const": "agentserver-platform"},
        "browserClientId": {"const": "agentserver-browser"}
      }
    },
    "externalOidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redirectUrl"],
      "properties": {
        "redirectUrl": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hydra", "externalOidc"],
      "properties": {
        "hydra": {"$ref": "#/$defs/hydra"},
        "externalOidc": {"$ref": "#/$defs/externalOidc"}
      }
    },
    "duration": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[0-9]"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityIssuer",
        "capabilitySigningKeyId",
        "manifestSigningKeyId",
        "runPolicyVersion",
        "allowedTools",
        "executionPolicyVersion",
        "shellPolicyDecision",
        "readFilePolicyDecision",
        "maxRunDuration",
        "maxApprovalTtl",
        "capabilityExpiryGrace",
        "enrollmentTokenTtl",
        "maxConcurrentAttempts",
        "runtimeManifestSha256",
        "checkpointAllowlistVersion",
        "finalExecSha256",
        "finalExecSizeBytes"
      ],
      "properties": {
        "capabilityIssuer": {"const": "spiffe://agentserver.byted.bps.dev/ns/agentserver/sa/agentserver-core"},
        "capabilitySigningKeyId": {"const": "run-capability-sg-v1"},
        "manifestSigningKeyId": {"const": "run-manifest-sg-v1"},
        "runPolicyVersion": {"$ref": "#/$defs/versionText"},
        "allowedTools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["list_environments", "read_file", "shell"]},
          "contains": {"const": "list_environments"},
          "minContains": 1,
          "maxContains": 1
        },
        "executionPolicyVersion": {"$ref": "#/$defs/versionText"},
        "shellPolicyDecision": {"enum": ["allow", "ask", "deny"]},
        "readFilePolicyDecision": {"enum": ["allow", "ask", "deny"]},
        "maxRunDuration": {"$ref": "#/$defs/duration"},
        "maxApprovalTtl": {"$ref": "#/$defs/duration"},
        "capabilityExpiryGrace": {"$ref": "#/$defs/duration"},
        "enrollmentTokenTtl": {"$ref": "#/$defs/duration"},
        "maxConcurrentAttempts": {"type": "integer", "minimum": 1, "maximum": 64},
        "runtimeManifestSha256": {"const": "5b7297d0a4e5eb294dc201ce2e82ae8f73f27b51c3360c8737e4338e46e3d128"},
        "checkpointAllowlistVersion": {"const": 1},
        "finalExecSha256": {"$ref": "#/$defs/sha256"},
        "finalExecSizeBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    },
    "versionText": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,127}$"
    },
    "managedEnvironmentRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "displayName", "description", "defaultCwd"],
      "properties": {
        "path": {"const": "/workspace"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 256},
        "description": {"type": "string", "maxLength": 2048},
        "defaultCwd": {"type": "string", "maxLength": 4096}
      }
    },
    "managedCompatibilityRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codexRelease", "codexCommit", "codexSha256"],
      "properties": {
        "codexRelease": {"const": "0.146.0"},
        "codexCommit": {"const": "e363b08c9175ac1cbe5893615dd2cb9ddf95043b"},
        "codexSha256": {"const": "2e863156ed35ecc5253b1e2f907a9143077b9f7cb51942070c61996471ff6e04"}
      }
    },
    "managedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "root", "compatibilityRuntime", "runtimeProfileSha256", "packSetSha256", "sandboxTtl", "activityTtl", "idleTtl"],
      "properties": {
        "environmentId": {"$ref": "#/$defs/uuid"},
        "root": {"$ref": "#/$defs/managedEnvironmentRoot"},
        "compatibilityRuntime": {"$ref": "#/$defs/managedCompatibilityRuntime"},
        "runtimeProfileSha256": {"$ref": "#/$defs/optionalSha256"},
        "packSetSha256": {"$ref": "#/$defs/optionalSha256"},
        "sandboxTtl": {"$ref": "#/$defs/duration"},
        "activityTtl": {"$ref": "#/$defs/duration"},
        "idleTtl": {"$ref": "#/$defs/duration"}
      }
    },
    "managedTAE": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "psm", "sandboxId", "sandboxRevisionId", "policy", "networkEvidence"],
      "properties": {
        "region": {"enum": ["sg", "cn", "boe", "i18n-bd", "i18n-tt"]},
        "psm": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^ /:@]+$"},
        "sandboxId": {"$ref": "#/$defs/dnsLabel"},
        "sandboxRevisionId": {"$ref": "#/$defs/dnsLabel"},
        "controlPlaneUrl": {"$ref": "#/$defs/httpsUrl"},
        "dataPlaneSuffix": {"$ref": "#/$defs/dnsName"},
        "bytecloudSite": {"type": "string", "minLength": 1, "maxLength": 128},
        "bytecloudJwtEndpoint": {"$ref": "#/$defs/httpsUrl"},
        "proxyProfile": {"enum": ["", "merlin-hl-1", "merlin-useast14a-1", "merlin-i18nbd-syd2a"]},
        "policy": {"$ref": "#/$defs/managedTAEPolicy"},
        "networkEvidence": {"$ref": "#/$defs/managedTAENetworkEvidence"}
      }
    },
    "managedSandboxRegions": {
      "type": "object", "additionalProperties": false,
      "required": ["defaultRegion", "regions"],
      "properties": {
        "defaultRegion": {"const": "i18n-tt"},
        "regions": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["cn", "boe", "i18n-bd", "i18n-tt"]},
          "contains": {"const": "i18n-tt"}
        }
      }
    },
    "managedSandboxGateway": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "clusterIp", "port", "serverName", "secret"],
      "properties": {
        "component": {"$ref": "#/$defs/dnsLabel"},
        "clusterIp": {"$ref": "#/$defs/ipv4"},
        "port": {"const": 8443},
        "serverName": {"$ref": "#/$defs/dnsName"},
        "secret": {"$ref": "#/$defs/dnsLabel"}
      }
    },
    "managedSandboxProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["region", "profileId", "bindingSha256", "gateway", "environment", "tae", "sandboxExternalEgress"],
      "properties": {
        "region": {"enum": ["cn", "boe", "i18n-bd", "i18n-tt"]},
        "profileId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
        "bindingSha256": {"$ref": "#/$defs/sha256"},
        "gateway": {"$ref": "#/$defs/managedSandboxGateway"},
        "environment": {"$ref": "#/$defs/managedEnvironment"},
        "tae": {"$ref": "#/$defs/managedTAE"},
        "sandboxExternalEgress": {"$ref": "#/$defs/optionalEgressRules"}
      }
    },
    "managedSandboxProxyProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "namespace", "podSelector", "port"],
      "properties": {
        "name": {"enum": ["merlin-hl-1", "merlin-useast14a-1", "merlin-i18nbd-syd2a"]},
        "url": {"type": "string", "minLength": 12, "maxLength": 2048, "pattern": "^socks5h://[^/]+:[0-9]+$"},
        "namespace": {"$ref": "#/$defs/dnsLabel"},
        "podSelector": {"$ref": "#/$defs/labelSelector"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "managedTAENetworkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "reportSha256", "bindingSha256", "evidenceRef"],
      "properties": {
        "version": {"type": "integer", "minimum": 0, "maximum": 5},
        "reportSha256": {"$ref": "#/$defs/optionalSha256"},
        "bindingSha256": {"$ref": "#/$defs/optionalSha256"},
        "evidenceRef": {"type": "string", "maxLength": 1024}
      }
    },
    "managedTAEPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "revision", "policySha256", "bindingSha256", "publicHost", "publicAccess",
        "publicWebhookRequired", "webhookMode", "webhookPsm", "webhookUrl", "webhookPath",
        "published", "approved", "evidenceRef"
      ],
      "properties": {
        "version": {"const": 1},
        "revision": {"$ref": "#/$defs/versionText"},
        "policySha256": {"const": "d086154a58d7f805ad95ee0842a7b63020394e2ba35aa881838eec1d97d16331"},
        "bindingSha256": {"$ref": "#/$defs/sha256"},
        "publicHost": {"enum": ["open.feishu.cn", "*.feishu.cn"]},
        "publicAccess": {"enum": ["whitelist", "system_default"]},
        "publicWebhookRequired": {"type": "boolean"},
        "webhookMode": {"enum": ["", "psm", "url"]},
        "webhookPsm": {"type": "string", "maxLength": 256, "pattern": "^[^ /:@]*$"},
        "webhookUrl": {"type": "string", "maxLength": 2048},
        "webhookPath": {"enum": ["", "/v1/policy"]},
        "published": {"type": "boolean"},
        "approved": {"type": "boolean"},
        "evidenceRef": {"type": "string", "maxLength": 1024}
      },
      "allOf": [
        {
          "if": {"properties": {"publicWebhookRequired": {"const": false}}, "required": ["publicWebhookRequired"]},
          "then": {"properties": {
            "publicHost": {"const": "*.feishu.cn"},
            "publicAccess": {"const": "system_default"},
            "webhookMode": {"const": ""},
            "webhookPsm": {"const": ""},
            "webhookUrl": {"const": ""},
            "webhookPath": {"const": ""}
          }}
        },
        {
          "if": {"properties": {"publicWebhookRequired": {"const": true}}, "required": ["publicWebhookRequired"]},
          "then": {"properties": {
            "publicHost": {"const": "open.feishu.cn"},
            "publicAccess": {"const": "whitelist"},
            "webhookMode": {"enum": ["psm", "url"]},
            "webhookPath": {"const": "/v1/policy"}
          }}
        },
        {
          "if": {"properties": {"webhookMode": {"const": "psm"}}, "required": ["webhookMode"]},
          "then": {"properties": {"webhookPsm": {"minLength": 1}, "webhookUrl": {"const": ""}}}
        },
        {
          "if": {"properties": {"webhookMode": {"const": "url"}}, "required": ["webhookMode"]},
          "then": {"properties": {"webhookPsm": {"const": ""}, "webhookUrl": {"minLength": 1}}}
        }
      ]
    },
    "managedLark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "cliSha256", "skillSha256", "policySha256"],
      "properties": {
        "enabled": {"type": "boolean"},
        "cliSha256": {"$ref": "#/$defs/sha256"},
        "skillSha256": {"$ref": "#/$defs/sha256"},
        "policySha256": {"const": "d086154a58d7f805ad95ee0842a7b63020394e2ba35aa881838eec1d97d16331"}
      }
    },
    "managedBkectl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sourceRevision", "cliSha256", "skillPackSha256", "policySha256"],
      "properties": {
        "enabled": {"type": "boolean"},
        "sourceRevision": {"const": "d813842ab03b24f2ac7a5b374507c273f41cbf21"},
        "cliSha256": {"const": "0331eb9836e46034d07bc88c52fa7af738dff7ad0b2b83d85ffe7cd6dfb7a590"},
        "skillPackSha256": {"const": "b752c88857ca7035580e9a9d51e9c63a09fd1bda28ce290c4e71b351c3779e51"},
        "policySha256": {"const": "642c86d38c499ae90f83223bdd7bd71eb2fe761874cb76cee5b1fecd2bb3bc99"}
      }
    },
    "managedExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "stage", "workspaceAllowlist", "baseInstructionsSha256", "environment", "tae", "lark", "bkectl"],
      "properties": {
        "enabled": {"type": "boolean"},
        "stage": {"enum": ["disabled", "policy-bootstrap", "active"]},
        "workspaceAllowlist": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        },
        "baseInstructionsSha256": {"const": "63a0de0d632b446bc4b25961751742bc6930c3092e3f9d57cae8b0c472e02f3c"},
        "environment": {"$ref": "#/$defs/managedEnvironment"},
        "tae": {"$ref": "#/$defs/managedTAE"},
        "lark": {"$ref": "#/$defs/managedLark"},
        "bkectl": {"$ref": "#/$defs/managedBkectl"}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {"properties": {"stage": {"enum": ["policy-bootstrap", "active"]}}},
          "else": {"properties": {"stage": {"const": "disabled"}}}
        },
        {
          "if": {"properties": {"stage": {"const": "policy-bootstrap"}}, "required": ["stage"]},
          "then": {
            "properties": {
              "environment": {
                "properties": {
                  "runtimeProfileSha256": {"const": ""},
                  "packSetSha256": {"const": ""}
                }
              },
              "tae": {
                "properties": {
                  "policy": {
                    "properties": {
                      "published": {"const": false},
                      "approved": {"const": false},
                      "evidenceRef": {"const": ""}
                    }
                  },
                  "networkEvidence": {
                    "properties": {
                      "version": {"const": 0},
                      "reportSha256": {"const": ""},
                      "bindingSha256": {"const": ""},
                      "evidenceRef": {"const": ""}
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "environment": {
                "properties": {
                  "runtimeProfileSha256": {"$ref": "#/$defs/sha256"},
                  "packSetSha256": {"$ref": "#/$defs/sha256"}
                }
              },
              "tae": {
                "properties": {
                  "policy": {
                    "properties": {
                      "published": {"const": true},
                      "approved": {"const": true},
                      "evidenceRef": {"type": "string", "minLength": 1, "maxLength": 1024}
                    }
                  },
                  "networkEvidence": {
                    "properties": {
                      "version": {"const": 5},
                      "reportSha256": {"$ref": "#/$defs/sha256"},
                      "bindingSha256": {"$ref": "#/$defs/sha256"},
                      "evidenceRef": {"type": "string", "minLength": 1, "maxLength": 1024}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "prefix",
        "s3Bucket",
        "s3Region",
        "s3Endpoint",
        "s3UsePathStyle"
      ],
      "properties": {
        "mode": {"const": "s3-plaintext-v1"},
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
          "not": {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}
        },
        "s3Bucket": {"$ref": "#/$defs/boundedText"},
        "s3Region": {"$ref": "#/$defs/boundedText"},
        "s3Endpoint": {"$ref": "#/$defs/httpsUrl"},
        "s3UsePathStyle": {"type": "boolean"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "platformGateway", "browserGateway", "executorGateway", "harnessPool", "harnessWorker", "llmproxy", "objectStore", "hydra", "sandboxGateway", "egressAuthorizer"],
      "properties": {
        "core": {"const": "agentserver-core-secrets"},
        "platformGateway": {"const": "agentserver-platform-secrets"},
        "browserGateway": {"const": "agentserver-browser-secrets"},
        "executorGateway": {"const": "agentserver-executor-secrets"},
        "harnessPool": {"const": "agentserver-pool-secrets"},
        "harnessWorker": {"const": "agentserver-worker-secrets"},
        "llmproxy": {"const": "agentserver-llmproxy-secrets"},
        "objectStore": {"const": "agentserver-object-store-secrets"},
        "hydra": {"const": "agentserver-hydra-secrets"},
        "sandboxGateway": {"const": "agentserver-sandbox-secrets"},
        "egressAuthorizer": {"const": "agentserver-egress-secrets"}
      }
    },
    "labelSelector": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^(?:(?:[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?)/)?[A-Za-z0-9](?:[-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 63,
        "pattern": "^(?:[A-Za-z0-9](?:[-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?)?$"
      }
    },
    "portList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 65535}
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr", "ports"],
      "properties": {
        "cidr": {
          "type": "string",
          "minLength": 5,
          "maxLength": 43,
          "pattern": "^(?:[0-9.]+/(?:[89]|[12][0-9]|3[0-2])|[0-9A-Fa-f:]+/(?:3[2-9]|[4-9][0-9]|1[01][0-9]|12[0-8]))$"
        },
        "ports": {"$ref": "#/$defs/portList"}
      }
    },
    "egressRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/egressRule"}
    },
    "optionalEgressRules": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/egressRule"}
    },
    "ingressCidrs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5, "maxLength": 43, "pattern": "^(?:[0-9.]+/(?:[0-9]|[12][0-9]|3[0-2])|[0-9A-Fa-f:]+/(?:3[2-9]|[4-9][0-9]|1[01][0-9]|12[0-8]))$"}
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dnsClusterIp",
        "dnsNamespace",
        "dnsPodSelector",
        "coreExternalEgress",
        "browserExternalEgress",
        "harnessExternalEgress",
        "sandboxExternalEgress",
        "egressAuthorizerExternalEgress",
        "egressAuthorizerIngress"
      ],
      "properties": {
        "dnsClusterIp": {"$ref": "#/$defs/ipv4"},
        "dnsNamespace": {"$ref": "#/$defs/dnsLabel"},
        "dnsPodSelector": {"$ref": "#/$defs/labelSelector"},
        "coreExternalEgress": {"$ref": "#/$defs/egressRules"},
        "browserExternalEgress": {"$ref": "#/$defs/optionalEgressRules"},
        "harnessExternalEgress": {"$ref": "#/$defs/optionalEgressRules"},
        "sandboxExternalEgress": {"$ref": "#/$defs/optionalEgressRules"},
        "egressAuthorizerExternalEgress": {"$ref": "#/$defs/optionalEgressRules"},
        "egressAuthorizerIngress": {"$ref": "#/$defs/ingressCidrs"}
      }
    },
    "resourceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "pattern": "^(?:[1-9][0-9]*|[1-9][0-9]*m)$"},
        "memory": {"$ref": "#/$defs/memoryQuantity"}
      }
    },
    "containerResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/$defs/resourceQuantity"},
        "limits": {"$ref": "#/$defs/resourceQuantity"}
      }
    },
    "memoryQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:Ki|Mi|Gi|Ti)$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "platformGateway",
        "browserGateway",
        "executorGateway",
        "harnessPool",
        "llmproxy",
        "hydra",
        "sandboxGateway",
        "egressAuthorizer",
        "runtimeTmpfs",
        "checkpointTmpfs",
        "scratchTmpfs"
      ],
      "properties": {
        "core": {"$ref": "#/$defs/containerResources"},
        "platformGateway": {"$ref": "#/$defs/containerResources"},
        "browserGateway": {"$ref": "#/$defs/containerResources"},
        "executorGateway": {"$ref": "#/$defs/containerResources"},
        "harnessPool": {"$ref": "#/$defs/containerResources"},
        "llmproxy": {"$ref": "#/$defs/containerResources"},
        "hydra": {"$ref": "#/$defs/containerResources"},
        "sandboxGateway": {"$ref": "#/$defs/containerResources"},
        "egressAuthorizer": {"$ref": "#/$defs/containerResources"},
        "runtimeTmpfs": {"$ref": "#/$defs/memoryQuantity"},
        "checkpointTmpfs": {"$ref": "#/$defs/memoryQuantity"},
        "scratchTmpfs": {"$ref": "#/$defs/memoryQuantity"}
      }
    }
  }
}
