{
  "version": 1,
  "region": "sg",
  "namespace": "agentserver",
  "clusterDomain": "cluster.local",
  "platform": "linux-amd64",
  "images": {
    "service": "registry-sg.byted.cs.ac.cn/agentserver/v2-service@sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "harness": "registry-sg.byted.cs.ac.cn/agentserver/v2-harness@sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "pullSecret": "agentserver-registry-pull"
  },
  "replicas": {
    "core": 2,
    "browserGateway": 2,
    "harnessPool": 2,
    "llmproxy": 2
  },
  "services": {
    "core": {"clusterIp": "10.96.10.10", "port": 8443},
    "browserGateway": {"clusterIp": "10.96.10.11", "port": 8080},
    "executorGateway": {
      "clusterIp": "10.96.10.12",
      "publicPort": 8080,
      "internalPort": 8443
    },
    "llmproxy": {"clusterIp": "10.96.10.13", "port": 8443}
  },
  "ingress": {
    "gatewayNamespace": "istio-ingress",
    "gatewayName": "istio-gateway",
    "gatewaySection": "https-byted-bps",
    "gatewayPodSelector": {
      "gateway.networking.k8s.io/gateway-name": "istio-gateway"
    },
    "frontendHostname": "agent.byted.bps.dev",
    "browserGatewayHostname": "browser-gateway.byted.bps.dev",
    "executorGatewayHostname": "executor-gateway.byted.bps.dev"
  },
  "bootstrap": {
    "workspaceId": "40000000-0000-4000-8000-000000000004",
    "sessionId": "50000000-0000-4000-8000-000000000005",
    "ownerUserId": "10000000-0000-4000-8000-000000000001",
    "externalOidcSubject": "replace-with-exact-idp-subject",
    "executorId": "20000000-0000-4000-8000-000000000002"
  },
  "spiffeTrustDomain": "agentserver.byted.bps.dev",
  "oauth": {
    "hydra": {
      "issuer": "https://agent.byted.bps.dev",
      "adminUrl": "https://hydra-admin.example.com",
      "publicOrigin": "https://agent.byted.bps.dev",
      "publicUpstream": "https://hydra-public.example.com",
      "introspectionUrl": "https://hydra-admin.example.com/admin/oauth2/introspect",
      "browserClientId": "agentserver-browser"
    },
    "externalOidc": {
      "issuer": "https://idp.example.com/oidc",
      "clientId": "agentserver-production",
      "redirectUrl": "https://agent.byted.bps.dev/auth/oidc/callback"
    }
  },
  "runtime": {
    "capabilityIssuer": "spiffe://agentserver.byted.bps.dev/ns/agentserver/sa/agentserver-core",
    "capabilitySigningKeyId": "run-capability-sg-v1",
    "manifestSigningKeyId": "run-manifest-sg-v1",
    "runPolicyVersion": "run-policy-v1",
    "allowedTools": ["list_environments", "read_file", "shell"],
    "executionPolicyVersion": "execution-policy-v1",
    "shellPolicyDecision": "ask",
    "readFilePolicyDecision": "allow",
    "maxRunDuration": "30m",
    "maxApprovalTtl": "5m",
    "capabilityExpiryGrace": "30s",
    "enrollmentTokenTtl": "5m",
    "maxConcurrentAttempts": 4,
    "runtimeManifestSha256": "5b7297d0a4e5eb294dc201ce2e82ae8f73f27b51c3360c8737e4338e46e3d128",
    "checkpointAllowlistVersion": 1,
    "finalExecSha256": "4444444444444444444444444444444444444444444444444444444444444444",
    "finalExecSizeBytes": 1048576
  },
  "objectStore": {
    "mode": "s3-plaintext-v1",
    "prefix": "agentserver/v2/production",
    "s3Bucket": "agentserver-production",
    "s3Region": "sg-central",
    "s3Endpoint": "https://tos-s3-sg.byted.org",
    "s3UsePathStyle": true
  },
  "secrets": {
    "core": "agentserver-core-secrets",
    "browserGateway": "agentserver-browser-secrets",
    "executorGateway": "agentserver-executor-secrets",
    "harnessPool": "agentserver-pool-secrets",
    "harnessWorker": "agentserver-worker-secrets",
    "llmproxy": "agentserver-llmproxy-secrets",
    "objectStore": "agentserver-object-store-secrets"
  },
  "network": {
    "dnsClusterIp": "10.96.0.10",
    "dnsNamespace": "kube-system",
    "dnsPodSelector": {
      "k8s-app": "kube-dns"
    },
    "coreExternalEgress": [{"cidr": "192.0.2.0/24", "ports": [443]}],
    "browserExternalEgress": [{"cidr": "198.51.100.0/24", "ports": [443]}],
    "harnessExternalEgress": [{"cidr": "192.0.2.0/24", "ports": [443]}]
  },
  "resources": {
    "core": {
      "requests": {"cpu": "500m", "memory": "512Mi"},
      "limits": {"cpu": "2", "memory": "2Gi"}
    },
    "browserGateway": {
      "requests": {"cpu": "250m", "memory": "256Mi"},
      "limits": {"cpu": "1", "memory": "1Gi"}
    },
    "executorGateway": {
      "requests": {"cpu": "500m", "memory": "512Mi"},
      "limits": {"cpu": "2", "memory": "2Gi"}
    },
    "harnessPool": {
      "requests": {"cpu": "1", "memory": "2Gi"},
      "limits": {"cpu": "4", "memory": "16Gi"}
    },
    "llmproxy": {
      "requests": {"cpu": "500m", "memory": "512Mi"},
      "limits": {"cpu": "2", "memory": "2Gi"}
    },
    "runtimeTmpfs": "8Gi",
    "checkpointTmpfs": "2Gi",
    "scratchTmpfs": "512Mi"
  }
}
