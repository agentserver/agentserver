{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentserver.dev/v2/schema/managed-sandbox-activation-manifest.schema.json",
  "title": "Agentserver v2 managed sandbox all-profile activation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "policyRevision", "policyEvidenceRef", "networkReportPath", "networkEvidenceRef"],
      "properties": {
        "region": {"enum": ["cn", "boe", "i18n-bd", "i18n-tt"]},
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,127}$"
        },
        "policyEvidenceRef": {"type": "string", "minLength": 1, "maxLength": 1024},
        "networkReportPath": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/"},
        "networkEvidenceRef": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  }
}
