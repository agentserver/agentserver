{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentserver.dev/v2/schema/insecure-dev-fixtures.schema.json",
  "title": "Agentserver v2 insecure development fixture launch config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authority", "hydra", "llmproxy"],
  "properties": {
    "version": {"const": 2},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "sessionId", "actorId"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/uuid"},
        "sessionId": {"$ref": "#/$defs/uuid"},
        "actorId": {"$ref": "#/$defs/uuid"}
      }
    },
    "hydra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introspectionEndpoint",
        "browserBearerTokenFile",
        "audience",
        "scope",
        "responseTtl",
        "publicOrigin",
        "browserClientId",
        "browserRedirectUri",
        "loginUrl",
        "consentUrl",
        "externalOidc"
      ],
      "properties": {
        "introspectionEndpoint": {"type": "string", "format": "uri", "pattern": "^http://", "maxLength": 4096},
        "browserBearerTokenFile": {"$ref": "#/$defs/absolutePath"},
        "audience": {"const": "agentserver-browser-api"},
        "scope": {"const": "openid sessions:read sessions:create sessions:update sessions:archive runs:read runs:create runs:cancel approvals:decide"},
        "responseTtl": {"type": "string", "minLength": 2, "maxLength": 64},
        "publicOrigin": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
        "browserClientId": {"const": "agentserver-browser"},
        "browserRedirectUri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
        "loginUrl": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
        "consentUrl": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
        "externalOidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "authorizationUrl", "clientId", "clientSecretFile", "redirectUri", "subject"],
          "properties": {
            "issuer": {"type": "string", "format": "uri", "pattern": "^http://", "maxLength": 4096},
            "authorizationUrl": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
            "clientId": {"const": "agentserver-core"},
            "clientSecretFile": {"$ref": "#/$defs/absolutePath"},
            "redirectUri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
            "subject": {"const": "agentserver-dev-user"}
          }
        }
      }
    },
    "llmproxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "certificateFile",
        "privateKeyFile",
        "runCapabilityKeyFile",
        "model",
        "provider",
        "toolNamespace",
        "scriptedTool",
        "finalMessage"
      ],
      "properties": {
        "endpoint": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
        "certificateFile": {"$ref": "#/$defs/absolutePath"},
        "privateKeyFile": {"$ref": "#/$defs/absolutePath"},
        "runCapabilityKeyFile": {"$ref": "#/$defs/absolutePath"},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "provider": {"type": "string", "minLength": 1, "maxLength": 256},
        "toolNamespace": {"const": "executor"},
        "scriptedTool": {"const": "list_environments"},
        "finalMessage": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    }
  }
}
